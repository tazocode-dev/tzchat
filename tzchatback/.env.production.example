# NODE_ENV는 파일에 넣지 않고 PM2 ecosystem이 먼저 production으로 지정합니다.
APP_NAME=
CORS_ORIGIN=https://tzchat.tazocode.com,https://localhost,capacitor://localhost
CAPACITOR_APP_ORIGINS=https://localhost,capacitor://localhost
PORT=11018
MONGO_URI=
SESSION_SECRET=
JWT_SECRET=
JWT_COOKIE_NAME=
FCM_SA_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.tazocode.tzchat
APNS_PRIVATE_KEY=
APNS_ENV=production
API_ORIGIN=https://tzchat.tazocode.com
APP_WEB_ORIGIN=https://tzchat.tazocode.com
PUBLIC_API_ORIGIN=https://tzchat.tazocode.com
TZMAIL_BASE_URL=http://127.0.0.1:10024/api
TZMAIL_APP_ID=com.tazocode.com
TZPHONE_BASE_URL=http://127.0.0.1:10022/api
TZPHONE_APP_ID=tzchat
TZPHONE_API_KEY=

# ── 일반 설정: 환경별로 거의 바뀌지 않는 고정값/만료시간/기능 플래그 ──
JWT_EXPIRES_IN=
REFRESH_TOKEN_EXPIRES_IN=
EMAIL_VERIFICATION_EXPIRES_MINUTES=
EMAIL_VERIFICATION_RESEND_SECONDS=
EMAIL_CODE_MAX_ATTEMPTS=
MAIL_PROVIDER=tzmail
EMAIL_CODE_FIXED=false
# 이전 이메일 로그인 호환 정책. 사용하지 않으면 비워둡니다.
EMAIL_FIXED_LOGIN_ACCOUNTS=
EMAIL_ACCOUNT_ROLE_OVERRIDES=
# 전화 로그인 정책: 번호는 하이픈 없는 숫자 11자리, 여러 항목은 쉼표로 구분합니다.
REVIEW_LOGIN_PHONES=00010000001,00010000002
REVIEW_CODE=123456
PHONE_FIXED_LOGIN_ACCOUNTS=00020000001:654321,99920000002:654321
PHONE_ACCOUNT_ROLE_OVERRIDES=00020000001:master,99920000002:user,01020000003:master
SMS_PROVIDER=tzphone
