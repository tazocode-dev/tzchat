# development 전용 완결 템플릿입니다. 모르는 값과 비밀값은 비워 둡니다.

# 기본 실행
APP_NAME=TZChat
HOST=0.0.0.0
PORT=11018

# 데이터베이스와 인증 비밀
MONGO_URI=mongodb://127.0.0.1:27017/tzchat_dev
MONGODB_URI=
MONGO_URL=
SESSION_SECRET=
JWT_SECRET=
JWT_COOKIE_NAME=tzchat.jwt
JWT_EXPIRES_IN=2h
REFRESH_TOKEN_EXPIRES_IN=30d

# 웹·앱 Origin
CORS_ORIGIN=http://localhost:11017
CAPACITOR_APP_ORIGINS=
API_ORIGIN=http://localhost:11018
APP_WEB_ORIGIN=http://localhost:11017
PUBLIC_API_ORIGIN=http://localhost:11018

# 이메일 인증
MAIL_PROVIDER=tzmail
EMAIL_CODE_FIXED=false
EMAIL_FIXED_LOGIN_ACCOUNTS=
EMAIL_ACCOUNT_ROLE_OVERRIDES=
EMAIL_VERIFICATION_EXPIRES_MINUTES=5
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
TZMAIL_BASE_URL=https://tzmail.tazocode.com/api
TZMAIL_APP_ID=com.tazocode.com
TZMAIL_API_KEY=

# 전화 인증
SMS_PROVIDER=tzphone
REVIEW_LOGIN_PHONES=
REVIEW_CODE=
PHONE_FIXED_LOGIN_ACCOUNTS=
PHONE_ACCOUNT_ROLE_OVERRIDES=
TZPHONE_BASE_URL=https://tzphone.tazocode.com/api
TZPHONE_APP_ID=tzchat
TZPHONE_API_KEY=

# 푸시
FCM_SA_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.tazocode.tzchat
APNS_PRIVATE_KEY=
APNS_ENV=sandbox

# 선택 런타임 설정
EMERGENCY_DURATION_SECONDS=3600
# 쉬표로 구분한 추가 공개 텍스트 차단어(기본 차단어에 합산)
UGC_BLOCKED_TERMS=
ALLOW_DEV_X_USER_ID=false
UPLOAD_ROOT=
APP_MODE=
FORCE_MOBILE_SESSION=false
USE_TLS=0
