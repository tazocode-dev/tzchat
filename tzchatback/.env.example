# 운영 기본·비밀 설정 예시입니다. NODE_ENV는 이 파일보다 먼저 지정합니다.
APP_NAME=
MAIL_PROVIDER=tzmail
EMAIL_CODE_FIXED=false
CORS_ORIGIN=
PORT=11018
MONGO_URI=
SESSION_SECRET=
JWT_SECRET=
JWT_COOKIE_NAME=
# Firebase Admin 서비스 계정 JSON은 Git에 넣지 않고, 저장소 외부의 절대경로만 지정합니다.
FCM_SA_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.tazocode.tzchat
APNS_PRIVATE_KEY=
APNS_ENV=sandbox
API_ORIGIN=
APP_WEB_ORIGIN=
PUBLIC_API_ORIGIN=
TZMAIL_BASE_URL=https://tzmail.tazocode.com/api
TZMAIL_APP_ID=com.tazocode.com
TZMAIL_API_KEY=
TZPHONE_BASE_URL=
TZPHONE_APP_ID=
TZPHONE_API_KEY=

# ── 일반 설정: 환경별로 거의 바뀌지 않는 고정값/만료시간/기능 플래그 ──
JWT_EXPIRES_IN=
REFRESH_TOKEN_EXPIRES_IN=
EMAIL_VERIFICATION_EXPIRES_MINUTES=
EMAIL_VERIFICATION_RESEND_SECONDS=
EMAIL_CODE_MAX_ATTEMPTS=
# 이메일·전화 로그인 계정 정책은 공통 비밀 파일이 아니라 .env.development/.env.production에서 관리합니다.
